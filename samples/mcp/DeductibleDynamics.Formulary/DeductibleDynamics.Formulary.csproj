<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Chapter 10: a small MCP server that ships with the book, so PriorAuthBot has an external tool
    server to connect to. It serves Deductible Dynamics' drug formulary (synthetic data) over stdio.
    Build it, then run: dotnet samples/mcp/DeductibleDynamics.Formulary/bin/Debug/net10.0/DeductibleDynamics.Formulary.dll
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
