{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.AI": "Information"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Ollama",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "ChatModel": "llama3.2:3b",
      "EmbeddingModel": "nomic-embed-text:v1.5",
      "VisionModel": "qwen2.5vl:3b"
    },
    "AzureOpenAI": {
      "ChatDeployment": "gpt-4.1-mini",
      "EmbeddingDeployment": "text-embedding-3-small"
    },
    "OpenAI": {
      "ChatModel": "gpt-4.1-mini",
      "EmbeddingModel": "text-embedding-3-small"
    },
    "Resilience": {
      "MaxAttempts": 3,
      "BaseDelay": "00:00:01",
      "MaxDelay": "00:00:20"
    },
    "CacheResponses": false,
    "CacheEmbeddings": false
  },
  "RateLimiting": {
    "Burst": 10,
    "RequestsPerMinute": 10
  },
  "Documents": {
    "Ocr": "Vision"
  },
  "Intake": {
    "MembersPath": "../../samples/intake/members.json",
    "AllowedGroup": "Claims"
  },
  "Catalog": {
    "Path": "../../samples/catalog/policy-catalog.json",
    "BatchSize": 32,
    "Top": 5,
    "Mode": "Hybrid"
  },
  "VectorStore": {
    "Provider": "InMemory",
    "Qdrant": {
      "Host": "localhost",
      "Port": 6334
    },
    "AzureAISearch": {}
  },
  "ConnectionStrings": {
    "priorauthbot": "Host=localhost;Port=5432;Database=priorauthbot;Username=priorauthbot;Password=priorauthbot-dev"
  },
  "Retrieval": {
    "Top": 6,
    "MinScore": 0.6,
    "Mode": "Hybrid",
    "Candidates": 20,
    "RrfK": 60,
    "MinTermCoverage": 0.5,
    "Rerank": {
      "Provider": "None",
      "Candidates": 10,
      "MinScore": 0,
      "ModelPath": "../../models/ms-marco-MiniLM-L6-v2"
    },
    "QueryRewrite": {
      "Enabled": false,
      "Count": 3
    }
  },
  "Chunking": {
    "MaxTokens": 350,
    "OverlapTokens": 50
  },
  "Context": {
    "MaxContextTokens": 1500,
    "MaxChunksPerDocument": 2
  },
  "Ingestion": {
    "DocumentsPath": "../../samples/documents",
    "Interval": "00:05:00"
  },
  "Auth": {
    "Mode": "Entra",
    "JwtBearer": {
      "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
      "Audience": "api://priorauthbot"
    }
  },
  "Identity": {
    "Groups": {}
  },
  "Tools": {
    "Hr": {
      "BaseAddress": "http://localhost:5180/",
      "Scopes": [
        "api://dd-hr/Pto.Read"
      ]
    },
    "Downstream": {
      "TenantId": "<tenant-id>",
      "ClientId": "<priorauthbot-app-registration-client-id>",
      "ManagedIdentityClientId": "<user-assigned-managed-identity-client-id>"
    }
  },
  "Mcp": {
    "Server": {
      "Resource": "api://priorauthbot",
      "Scopes": [
        "api://priorauthbot/PriorAuthBot.Search"
      ]
    },
    "Servers": {
      "formulary": {
        "Enabled": false,
        "Transport": "Stdio",
        "Command": "dotnet",
        "Arguments": [
          "../../samples/mcp/DeductibleDynamics.Formulary/bin/Debug/net10.0/DeductibleDynamics.Formulary.dll"
        ],
        "ForwardEnvironment": [
          "DOTNET_ROOT"
        ],
        "ExpectedServerName": "dd-formulary",
        "ExpectedServerVersion": "1.0.0",
        "Tools": {
          "search_formulary": {
            "Sha256": "a95fce7e01871b1c040f53a171f558868721a895e22fda0a489f2a96a8b7e701",
            "ReadOnly": true
          },
          "list_tiers": {
            "Sha256": "c683c0cd23127592d84f5c803c1a35e55cb6c2a90319775cb15d988b18f054d8",
            "ReadOnly": true
          }
        }
      }
    }
  }
}
